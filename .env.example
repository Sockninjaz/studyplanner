# =====================================================================
# StudyPlanner Production Environment Schema (.env.example)
# Hardened SaaS Configuration for Dutch High School Students & Parents
# =====================================================================

# ---------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Data Privacy & EU Hosting)
# ---------------------------------------------------------------------
# Primary database connection string (MongoDB or PostgreSQL)
# Hosted in EU datacenters (e.g., Frankfurt/Amsterdam) for GDPR compliance
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/studyplanner?retryWrites=true&w=majority"
POSTGRES_URL="postgresql://<username>:<password>@eu-central-1.postgres.serverless.com/studyplanner?sslmode=require"

# ---------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (NextAuth)
# ---------------------------------------------------------------------
NEXTAUTH_URL="https://studyplanner.nl"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-byte-base64-random-secret"

# ---------------------------------------------------------------------
# 3. RATE LIMITING (Upstash Redis - Pillar 2)
# ---------------------------------------------------------------------
# Max 5 requests per IP per 10 minutes on AI endpoints.
# If omitted, system seamlessly falls back to in-memory sliding window.
UPSTASH_REDIS_REST_URL="https://eu-central-1-your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-rest-token"

# ---------------------------------------------------------------------
# 4. ARTIFICIAL INTELLIGENCE (Strict Guardrails & Ledger)
# ---------------------------------------------------------------------
# Hard-capped at 1500 max_tokens with strict system prompts & loop breaker
OPENAI_API_KEY="sk-proj-your-openai-api-key"
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSy-your-google-gemini-api-key"

# ---------------------------------------------------------------------
# 5. PAYMENTS & WEBHOOKS (Stripe + iDEAL - Pillar 4)
# ---------------------------------------------------------------------
# Secret API Key (begins with sk_live_ or sk_test_)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
# Webhook signing secret (obtained from Stripe Dashboard -> Webhooks -> Signing Secret)
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"
# Client-side Publishable key (begins with pk_live_ or pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
# Price ID for StudyPlanner Pro subscription (€4.99/month)
STRIPE_PRICE_ID_PRO="price_1234567890abcdef"

# ---------------------------------------------------------------------
# 6. MONITORING & AUDITING (Sentry - Pillar 5)
# ---------------------------------------------------------------------
# Sensitive token scrubbing enabled: redaction of tokens, cookies, passwords
NEXT_PUBLIC_SENTRY_DSN="https://xxxxxxxx@o000000.ingest.sentry.io/0000000"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ENVIRONMENT="production"

# ---------------------------------------------------------------------
# 7. EMAIL NOTIFICATIONS (Weekly Parent Updates)
# ---------------------------------------------------------------------
RESEND_API_KEY="re_your-resend-api-key"
NOTIFICATION_FROM_EMAIL="StudyPlanner <updates@studyplanner.nl>"
